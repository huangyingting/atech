{
  "name": "atech-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:generate:postgres": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema prisma/schema.postgres.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "invite:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "test:e2e": "node tests/e2e.cjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^12.10.0",
    "lucide-react": "^1.16.0",
    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "pg": "^8.20.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "playwright": "^1.64.1",
    "postcss": "^8.4.47",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
